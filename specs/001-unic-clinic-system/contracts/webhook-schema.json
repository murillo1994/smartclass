{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvolutionApiV2MultiTenantWebhookPayload",
  "type": "object",
  "required": ["event", "instance", "data"],
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "messages.upsert",
        "messages.update",
        "connection.update",
        "qrcode.updated",
        "chats.update",
        "contacts.update"
      ]
    },
    "instance": {
      "type": "string",
      "description": "Identificador da instancia no formato tenant_{tenant_id}"
    },
    "destination": {
      "type": "string"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "sender": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "key": {
          "type": "object",
          "required": ["remoteJid", "fromMe", "id"],
          "properties": {
            "remoteJid": { "type": "string" },
            "fromMe": { "type": "boolean" },
            "id": { "type": "string" }
          }
        },
        "pushName": {
          "type": "string"
        },
        "message": {
          "type": "object",
          "properties": {
            "conversation": { "type": "string" },
            "extendedTextMessage": {
              "type": "object",
              "properties": {
                "text": { "type": "string" }
              }
            },
            "audioMessage": { "type": "object" },
            "imageMessage": { "type": "object" },
            "videoMessage": { "type": "object" },
            "documentMessage": { "type": "object" }
          }
        },
        "messageType": {
          "type": "string"
        },
        "messageTimestamp": {
          "type": "integer"
        }
      }
    }
  }
}
