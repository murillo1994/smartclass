{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartClass Telemetry Ingestion Contract",
  "description": "Especificação do contrato OpenAPI / JSON Schema para o endpoint de ingestão de telemetria IoT do SmartClass.",
  "endpoint": "/api/v1/medicoes",
  "method": "POST",
  "request": {
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "type": "object",
      "properties": {
        "sala_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Identificador único do ambiente ou sala escolar",
          "examples": ["Sala 101", "Laboratorio-01", "Auditório Principal"]
        },
        "temperatura": {
          "type": "number",
          "minimum": -40.0,
          "maximum": 85.0,
          "description": "Temperatura em graus Celsius com até 2 casas decimais",
          "examples": [23.5, 26.0, 19.85]
        },
        "umidade": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 100.0,
          "description": "Umidade relativa do ar em porcentagem (opcional)",
          "examples": [55.0, 62.4, null]
        }
      },
      "required": ["sala_id", "temperatura"],
      "additionalProperties": false
    }
  },
  "responses": {
    "201": {
      "description": "Medição recebida, validada e persistida com sucesso",
      "body": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "sala_id": { "type": "string" },
              "temperatura": { "type": "number" },
              "umidade": { "type": ["number", "null"] },
              "data_registro": { "type": "string", "format": "date-time" }
            },
            "required": ["id", "sala_id", "temperatura", "data_registro"]
          }
        },
        "required": ["status", "message", "data"]
      }
    },
    "400": {
      "description": "Requisição inválida (payload ausente, malformado ou campos obrigatórios faltantes)",
      "body": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["error"] },
          "message": { "type": "string" },
          "code": { "type": "integer", "enum": [400] },
          "errors": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["status", "message", "code"]
      }
    },
    "500": {
      "description": "Erro interno do servidor ou falha na camada de persistência",
      "body": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["error"] },
          "message": { "type": "string" },
          "code": { "type": "integer", "enum": [500] }
        },
        "required": ["status", "message", "code"]
      }
    }
  }
}
