# =========================================================================================
# SmartClass - Configurações de Ambiente (.env.example)
# =========================================================================================
# Instruções:
# 1. Faça uma cópia deste arquivo com o nome '.env':
#    No Linux/macOS:  cp .env.example .env
#    No Windows PowerShell: Copy-Item .env.example .env
# 2. Preencha os valores conforme seu ambiente de execução.
# =========================================================================================

# -----------------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL)
# -----------------------------------------------------------------------------------------
POSTGRES_DB=smartclass_db
POSTGRES_USER=smartclass_user
POSTGRES_PASSWORD=sua_senha_segura_do_banco
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de conexão montada (usada pela aplicação e migrations)
DATABASE_URL=postgresql://smartclass_user:sua_senha_segura_do_banco@localhost:5432/smartclass_db

# -----------------------------------------------------------------------------------------
# 2. SERVIDOR BACKEND (Flask / Gunicorn)
# -----------------------------------------------------------------------------------------
FLASK_ENV=development
DEBUG=True
PORT=5000

# Chave secreta da aplicação para sessões e tokens (gere uma string aleatória)
FLASK_SECRET_KEY=smartclass_super_secret_key_change_me_in_production

# -----------------------------------------------------------------------------------------
# 3. CREDENCIAIS DO OPERADOR DO PAINEL WEB
# -----------------------------------------------------------------------------------------
# Defina o usuário e senha que você utilizará para fazer login na interface web:
SMARTCLASS_USER=admin
SMARTCLASS_PASS=sua_senha_de_acesso
